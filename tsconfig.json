{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // The Nix-supplied @proseql closure carries an Effect beta whose own declarations do
    // not typecheck against this TypeScript version. Only the insides of .d.ts files are
    // skipped, so our sources are still checked against those declarations.
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "contracts/generated/**/*.ts",
    "packages/**/*.ts",
    "plugins/**/*.ts",
    "clients/**/*.ts"
  ]
}
