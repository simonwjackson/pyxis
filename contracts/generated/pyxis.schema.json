{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpcContractSchema",
  "description": "Schema root, so one generated JSON Schema covers both directions of the wire.",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/RpcRequest"
    },
    "response": {
      "$ref": "#/$defs/RpcResponse"
    },
    "plugin_request": {
      "$ref": "#/$defs/PluginRequestEnvelope"
    },
    "plugin_response": {
      "$ref": "#/$defs/PluginResponseEnvelope"
    }
  },
  "required": [
    "request",
    "response",
    "plugin_request",
    "plugin_response"
  ],
  "$defs": {
    "RpcRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "system.status.get"
            },
            "payload": {
              "$ref": "#/$defs/EmptyRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.device.claim"
            },
            "payload": {
              "$ref": "#/$defs/DeviceClaimRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.device.pair"
            },
            "payload": {
              "$ref": "#/$defs/DevicePairRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.pairing.create"
            },
            "payload": {
              "$ref": "#/$defs/EmptyRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.token.create"
            },
            "payload": {
              "$ref": "#/$defs/ApiTokenCreateRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.token.revoke"
            },
            "payload": {
              "$ref": "#/$defs/ApiTokenRevokeRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "account.list"
            },
            "payload": {
              "$ref": "#/$defs/EmptyRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "account.create"
            },
            "payload": {
              "$ref": "#/$defs/AccountCreateRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "plugin.list"
            },
            "payload": {
              "$ref": "#/$defs/EmptyRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        }
      ]
    },
    "EmptyRequest": {
      "type": "object",
      "additionalProperties": false
    },
    "DeviceClaimRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "DevicePairRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ]
    },
    "ApiTokenCreateRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "scopes"
      ]
    },
    "ApiTokenRevokeRequest": {
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tokenId"
      ]
    },
    "AccountCreateRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "deviceName": {
          "description": "The creating physical device gets a new grant scoped to the new account.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "deviceName"
      ]
    },
    "RpcResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "system.status.get"
            },
            "outcome": {
              "$ref": "#/$defs/SystemStatusOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.device.claim"
            },
            "outcome": {
              "$ref": "#/$defs/DeviceClaimOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.device.pair"
            },
            "outcome": {
              "$ref": "#/$defs/DevicePairOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.pairing.create"
            },
            "outcome": {
              "$ref": "#/$defs/PairingCreateOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.token.create"
            },
            "outcome": {
              "$ref": "#/$defs/ApiTokenCreateOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "auth.token.revoke"
            },
            "outcome": {
              "$ref": "#/$defs/CommandOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "account.list"
            },
            "outcome": {
              "$ref": "#/$defs/AccountListOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "account.create"
            },
            "outcome": {
              "$ref": "#/$defs/AccountCreateOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "plugin.list"
            },
            "outcome": {
              "$ref": "#/$defs/PluginListOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "rpc.failure"
            },
            "outcome": {
              "$ref": "#/$defs/RpcProtocolFailureOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        }
      ]
    },
    "SystemStatusOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcSystemStatus"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "RpcSystemStatus": {
      "description": "Service health and capability summary.\n\n`pluginCount` and `capabilities` are part of status because the core is required to run\nwith zero plugins installed. A client discovers what is actually possible here rather\nthan assuming a provider exists.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "contractId": {
          "type": "string"
        },
        "accountCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pluginCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "capabilities": {
          "description": "Capability classes currently served by at least one live plugin, for example\n`source` or `output`. Empty is a valid, working state.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "contractId",
        "accountCount",
        "pluginCount",
        "capabilities"
      ]
    },
    "RpcFailure": {
      "description": "Uniform failure envelope.\n\n`retryable` exists so an offline client can decide whether to keep a queued write or\nsurface it as a permanent error, without parsing `code` strings.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "DeviceClaimOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcAuthGrant"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "pairingRequired"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "RpcAuthGrant": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/RpcAccount"
        },
        "device": {
          "$ref": "#/$defs/RpcDevice"
        },
        "bearerToken": {
          "description": "Returned exactly once. Clients persist this in their local ProseQL worker store.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "account",
        "device",
        "bearerToken"
      ]
    },
    "RpcAccount": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isDefault": {
          "description": "True for the account created automatically on first boot. Exactly one account\ncarries this flag.",
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "isDefault",
        "createdAt"
      ]
    },
    "RpcDevice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "DevicePairOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcAuthGrant"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalidCode"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "PairingCreateOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcPairingCode"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "RpcPairingCode": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "expiresAt"
      ]
    },
    "ApiTokenCreateOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcApiTokenGrant"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "invalidScope"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "RpcApiTokenGrant": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/$defs/RpcApiToken"
        },
        "bearerToken": {
          "description": "Returned once; only its hash is stored.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "bearerToken"
      ]
    },
    "RpcApiToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scopes",
        "createdAt"
      ]
    },
    "CommandOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "succeeded"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "AccountListOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RpcAccount"
              }
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "AccountCreateOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/RpcAuthGrant"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "nameTaken"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "PluginListOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RpcPlugin"
              }
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "RpcPlugin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "capabilities",
        "status"
      ]
    },
    "RpcProtocolFailureOutcome": {
      "description": "A request that cannot enter operation dispatch. This is separate from an operation's\n`unavailable` outcome: no operation exists yet to own the failure.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "value": {
              "$ref": "#/$defs/RpcFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "PluginRequestEnvelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/PluginRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "request"
      ]
    },
    "PluginRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "plugin.handshake"
            },
            "payload": {
              "$ref": "#/$defs/PluginHandshakeRequest"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "capability.call"
            },
            "payload": {
              "$ref": "#/$defs/PluginCapabilityCall"
            }
          },
          "required": [
            "_tag",
            "payload"
          ]
        }
      ]
    },
    "PluginHandshakeRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion"
      ]
    },
    "PluginCapabilityCall": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/PluginCapability"
        },
        "operation": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/PluginValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "operation",
        "input"
      ]
    },
    "PluginCapability": {
      "type": "string",
      "enum": [
        "source",
        "output",
        "provider",
        "enricher"
      ]
    },
    "PluginValue": {
      "description": "JSON represented as a recursive, language-neutral sum type rather than `any`. This is\nthe input/output escape hatch for capability-specific operations while their envelopes\nand failure behavior stay fully typed.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginValue"
          }
        }
      ]
    },
    "PluginResponseEnvelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/PluginResponse"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "response"
      ]
    },
    "PluginResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "plugin.handshake"
            },
            "outcome": {
              "$ref": "#/$defs/PluginHandshakeOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "const": "capability.call"
            },
            "outcome": {
              "$ref": "#/$defs/PluginCallOutcome"
            }
          },
          "required": [
            "_tag",
            "outcome"
          ]
        }
      ]
    },
    "PluginHandshakeOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/PluginManifest"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "value": {
              "$ref": "#/$defs/PluginFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    },
    "PluginManifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginCapability"
          }
        },
        "configSchema": {
          "description": "JSON Schema for per-account plugin configuration and credentials.",
          "$ref": "#/$defs/PluginValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "protocolVersion",
        "capabilities",
        "configSchema"
      ]
    },
    "PluginFailure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "PluginCallOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ready"
            },
            "value": {
              "$ref": "#/$defs/PluginValue"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/PluginFailure"
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    }
  }
}
