#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
fixtures="$root/plugins/pandora/fixtures"
for file in \
  auth.partnerLogin.json \
  auth.userLogin.json \
  user.getStationList.json \
  station.getPlaylist.json \
  music.search.json
do
  if [[ ! -f "$fixtures/$file" ]]; then
    echo "Missing Pandora fixture: $fixtures/$file" >&2
    echo "Run the local fixture recorder first." >&2
    exit 1
  fi
done

PYXIS_PANDORA_FIXTURE_DIR="$fixtures" \
  bun test "$root/plugins/pandora/src/fixture-replay.test.ts"
